{
	"schemaVersion": 1,
	"id": "fractalbuildings",
	"version": "${version}",
	"name": "Fractal Buildings",
	"description": "Generates villages, towns and cities from rules rather than stamped templates: every building is planned for its lot and the terrain around it.",
	"authors": ["John Reeves"],
	"license": "MIT",
	"icon": "assets/fractalbuildings/icon.png",
	"environment": "*",
	"mixins": ["fractalbuildings.mixins.json"],
	"entrypoints": {
		"main": ["dev.fractalbuildings.mod.FractalBuildingsMod"],
		"client": ["dev.fractalbuildings.mod.client.FbNoteClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
