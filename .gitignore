# Claude Code worktrees (one per branch; see README "Long runs with agents")
/.claude/worktrees/
# Agent reports for the verifier/coordinator (see .claude/agents/coder.md)
/.claude/reports/
# Lock files for shared resources (see CLAUDE.md "Parallel work")
/.claude/*.lock
/.claude/*.lock.holder
/.claude/*.lock.wait.*
/.claude/suite.lock.*
# The worker pool: host names stay local (see scripts/workers.conf.example)
/.claude/workers.conf
# scripts/anywhere.sh queue, claims and route log
/.claude/anywhere/
# scripts/postmerge-run.sh state: result files, logs (see scripts/squash-merge.sh)
/.claude/postmerge/
/.claude/postmerge.log

# editor swap files
*.swp

# viewer gallery (npm run gen / gallery)
viewer/gallery-data/
viewer/dist-gallery/
mod/logs/
# Generated state shared by every worktree (scripts/board.sh, ask-user.sh, needs-user.sh)
/.claude/board/
/.claude/status/
# Merge queue state (scripts/merge-queue.sh)
/.claude/merge-queue/
# The generated status page in the SilverBullet space (scripts/status.sh --publish writes it at the
# root of the docs-feedback worktree; it must never be committed as feedback)
/STATUS.md
# World cache (scripts/worlds.sh, W14): generated saves shared by every worktree
/.claude/worlds/
