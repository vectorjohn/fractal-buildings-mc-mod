{
  "name": "fractal-buildings-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "screenshot": "tsc --noEmit && vite build && playwright test",
    "test": "tsc --noEmit && vitest run",
    "gen": "bash scripts/gen-gallery.sh",
    "city": "bash scripts/gen-city.sh",
    "dev:gen": "npm run gen && FB_GALLERY=1 vite",
    "gallery": "npm run gen && tsc --noEmit && FB_GALLERY=1 vite build && FB_GALLERY=1 GALLERY=1 playwright test e2e/gallery.spec.ts",
    "city-gallery": "npm run city && tsc --noEmit && vite build && CITY_GALLERY=1 playwright test e2e/city.spec.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
